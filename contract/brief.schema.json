{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falsiq.dev/contracts/1.0.0/brief.schema.json",
  "title": "Falsiq obligation brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "case_id",
    "ledger_head",
    "intent",
    "obligations",
    "discretion",
    "open_ambiguities",
    "provenance"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "case_id": {"type": "string"},
    "ledger_head": {"type": "string"},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "amended_from"],
      "properties": {
        "text": {"type": "string"},
        "amended_from": {"type": ["string", "null"]}
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "kind",
          "statement",
          "settles",
          "evidence",
          "verification"
        ],
        "properties": {
          "obligation_id": {"type": "string"},
          "kind": {"enum": ["required", "forbidden"]},
          "statement": {"type": "string"},
          "settles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attack_id",
              "ruling_id",
              "klass",
              "choice",
              "artifact_excerpt",
              "hate_scenario"
            ],
            "properties": {
              "attack_id": {"type": "string"},
              "ruling_id": {"type": "string"},
              "klass": {
                "enum": ["boundary", "consequence", "prototype", "conflict", "omission"]
              },
              "choice": {"type": ["string", "null"]},
              "artifact_excerpt": {"type": "string"},
              "hate_scenario": {"type": "string"}
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expressible",
              "renderer",
              "strength",
              "artifact_path",
              "reason"
            ],
            "properties": {
              "expressible": {"type": "boolean"},
              "renderer": {
                "type": ["string", "null"],
                "enum": ["pytest", "command", "assertion", "checklist", null]
              },
              "strength": {
                "type": ["string", "null"],
                "enum": ["executable", "attested", null]
              },
              "artifact_path": {"type": ["string", "null"]},
              "reason": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "discretion": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "evidence"],
        "properties": {
          "decision": {"type": "string"},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attack_id", "ruling_id"],
            "properties": {
              "attack_id": {"type": "string"},
              "ruling_id": {"type": "string"}
            }
          }
        }
      }
    },
    "open_ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "reason"],
        "properties": {
          "decision": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attacker_versions", "deriver_version", "policy", "profile"],
      "properties": {
        "attacker_versions": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "deriver_version": {"type": "string"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_rounds"],
          "properties": {"max_rounds": {"type": "integer", "minimum": 1}}
        },
        "profile": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "digest"],
          "properties": {
            "name": {"type": "string"},
            "digest": {"type": "string"}
          }
        }
      }
    }
  }
}
