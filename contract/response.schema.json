{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falsiq.dev/contracts/1.0.0/response.schema.json",
  "title": "Falsiq RPC response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok", "result"],
      "properties": {
        "id": {"type": "string"},
        "ok": {"const": true},
        "result": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok", "error"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"}
          }
        }
      }
    }
  ]
}
